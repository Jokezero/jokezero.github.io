---
/**
 * 站点基础骨架：所有页面共用的外壳。
 *
 * 顺序在这个文件里很重要：
 *   1. 主题初始化内联脚本 —— 必须在样式表之前同步执行，否则首帧会闪一下白/黑
 *   2. 首屏兜底内联样式 —— 保证 CSS 还没下载完时底色就已经是对的
 *   3. 字体 preload —— 只预加载首屏真正会用到的那一个字重（400）
 */
import "../styles/global.css";
import { SITE } from "../config/site";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Analytics from "../components/analytics/Analytics.astro";
import PageTransition from "../components/effects/PageTransition.astro";
import Intro from "../components/effects/Intro.astro";
import ScrollEffects from "../components/effects/ScrollEffects.astro";

interface Props {
  /** 页面标题；站点名会自动追加在后。 */
  title?: string;
  /** 页面摘要，缺省时用站点描述。 */
  description?: string;
}

const { title, description = SITE.description } = Astro.props;

// 首页标题直接就是站点名，其他页面为 "页面名 · 站点名"。
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;

// canonical / OG 用的绝对地址。
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      跨文档跳转时，浏览器在新文档首帧之前会先铺一层"底色"；
      不声明颜色方案时那层底色是白的 —— 深色站点上就会闪一下白
      （也就是"切换页面时露出浏览器的底"）。
      声明 color-scheme 后，浏览器知道本站深色优先，首帧底色直接是黑的。
    -->
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- favicon：内联 SVG，避免浏览器自动请求 /favicon.ico 造成 404 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />

    <!--
      主题初始化（防闪烁）：同步执行、约 200 字节。
      优先级：本地记忆 > 系统偏好 > 深色兜底。
      存储键与 src/config/site.ts 的 themeStorageKey 保持一致。
    -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("zeroweb-theme");
          const theme =
            saved === "light" || saved === "dark"
              ? saved
              : matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <!--
      动效门闸（防闪烁 + 防误播）：必须在样式表之前同步执行。
      · 从站内转场进来 → 给 <html> 挂 is-arriving，幕布首帧就盖满画面
      · 直接打开 / 刷新 → 首次进入才播字符绘制（同一会话只播一次）
      · 开启"减少动态效果" → 两者都不播
    -->
    <script is:inline>
      (() => {
        const html = document.documentElement;
        try {
          const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const arriving = sessionStorage.getItem("zw-arriving");
          if (arriving) sessionStorage.removeItem("zw-arriving");
          if (reduced) {
            html.classList.add("no-intro");
          } else if (arriving) {
            html.classList.add("is-arriving");
            // 关键：转场进来时也要把"进场遮罩"永久关掉。
            // 只靠 is-arriving 不够 —— 动效脚本会在下一帧摘掉这个类，
            // 而字符绘制脚本这时可能还没执行完，于是黑遮罩会闪一帧。
            html.classList.add("no-intro");
            if ("scrollRestoration" in history) history.scrollRestoration = "manual";
            // 兜底：万一转场脚本没跑起来，2 秒后也要把幕布放掉，不能一直盖着
            setTimeout(() => html.classList.remove("is-arriving"), 2000);
          } else if (sessionStorage.getItem("zw-intro")) {
            html.classList.add("no-intro");
          }
        } catch {
          html.classList.add("no-intro");
        }
      })();
    </script>
    <!-- 关键 CSS 内联：样式表到达之前，底色与配色方案就已经是对的 -->
    <style is:inline>
      html {
        background: #000;
        color-scheme: dark;
      }
      html[data-theme="light"] {
        background: #fff;
        color-scheme: light;
      }
      /*
       * 幕布与开机遮罩的"关键样式"也内联在这里。
       * 原因：它们原来是靠外部样式表定位的，而缓存命中时浏览器可能在样式表生效前
       * 就画出了第一帧 —— 那一刻幕布只是个没背景、没定位的普通 div，完全不可见，
       * 用户看到的就是"页面闪一下、动效还短了一截"。这几行保证它们从第一帧起就是
       * 一块盖满屏幕的黑幕（浅色主题下是白幕）。
       */
      #curtain {
        position: fixed;
        inset: 0;
        z-index: 70;
        background-color: #000;
        transform: translate3d(0, -100%, 0);
      }
      html[data-theme="light"] #curtain {
        background-color: #fff;
      }
      html.is-arriving #curtain {
        transform: translate3d(0, 0, 0);
      }
      #boot {
        position: fixed;
        inset: 0;
        z-index: 80;
        background-color: #000;
      }
      html[data-theme="light"] #boot {
        background-color: #fff;
      }
      /* 不该播进场动画时，遮罩从第一帧起就不存在 */
      html.no-intro #boot,
      html.is-arriving #boot {
        display: none;
      }
    </style>

    <!-- 只预加载首屏必需的 400 字重；600 用到时才下载 -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-latin-400.woff2"
      crossorigin
    />

    <!-- 社交分享（P2 会补每篇文章的 OG 图） -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- RSS 自动发现：界面不放订阅入口，但让阅读器/浏览器能自动找到 -->
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  </head>

  <body class="flex min-h-dvh flex-col bg-bg-0 text-fg-1">
    <!--
      幕布与开机遮罩放在 <body> 最前面，而不是页脚之后。
      文档是边解析边绘制的：放在最后意味着"快速加载（缓存命中）"
      时页面可能已经画出来、而幕布还没被解析到 —— 那就是闪一下的来源。
    -->
    <PageTransition />
    <Intro />

    <!-- 跳转正文：键盘用户按 Tab 的第一站（不是视觉装饰，是无障碍必需品） -->
    <a
      href="#main"
      class="sr-only-focusable tap absolute left-6 top-3 z-[100] rounded-full border border-line-1 bg-bg-1 px-4 py-2 font-mono text-micro tracking-[0.14em] uppercase text-fg-1 no-underline"
    >
      跳到正文
    </a>

    <Header />

    <!-- 内容层压 z-index：整页背景是 fixed + z-0，静态内容必须抬到它上面（§10 第 2 条坑） -->
    <!--
      data-pagefind-body：只把 <main> 里的内容交给搜索索引。
      不写这一条时，Pagefind 会把整份 HTML 都索引进去 —— 幕布上的 "LOADING"、
      跳转链接、顶栏导航、页脚社交链接都会变成可被搜到的"词条"，
      搜索结果里就会出现一堆 LOADING.xxx 这种本该被忽略的噪声。
    -->
    <main id="main" data-pagefind-body class="relative z-[2] flex-1">
      <slot />
    </main>

    <Footer />

    <!-- 统计脚本：开关关闭或没填 token 时什么都不渲染 -->
    <Analytics />

    <!-- 滚动进度线：位置无关，放在最后即可 -->
    <ScrollEffects />
  </body>
</html>
