---
/**
 * 首页。
 *
 * 现在这里只有 Hero 的**文字部分**，用的是 P1 的设计令牌：
 *   kicker（等宽微标签）→ 大标题 → 说明 → 阶段标注
 * 招牌视觉（三体运动背景、滚动特效、页面切换）属于 P3，
 * 届时会在这段结构外面套上画布与动效，文字内容本身不用重写。
 *
 * 想改这里的文字：直接改下面的 HTML，或改 src/config/site.ts 里的站点名与描述。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import { SITE } from "../config/site";
---

<BaseLayout>
  <Container
    width="layout"
    class="flex min-h-[70dvh] flex-col justify-center py-24"
  >
    <!-- 等宽全大写微标签：全站统一的"工程感"细节 -->
    <p class="font-mono text-micro tracking-[0.2em] text-fg-3 uppercase">
      Personal Site · Static Build
    </p>

    <!-- 站点大标题：内容来自配置，改站点名只需改一处 -->
    <h1
      class="mt-6 text-step-5 leading-[1.05] font-semibold tracking-[-0.02em] text-fg-0"
    >
      {SITE.name}
    </h1>

    <p class="mt-8 max-w-[52ch] text-step-0 leading-[1.9] text-fg-2">
      {SITE.description}
    </p>

    <!-- 阶段标注：P3 落地招牌视觉后删掉这一行 -->
    <p class="mt-14 font-mono text-micro tracking-[0.12em] text-fg-3">
      P1 · 设计系统与骨架 · 招牌视觉在 P3 落地
    </p>
  </Container>
</BaseLayout>
