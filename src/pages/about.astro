---
/**
 * 关于页（docs/01-design-spec.md §4.5.4 v2）。
 *
 * 结构最简、每一项都可预测：
 *   第 1 屏 = 标题（kicker + 大标题 + 说明 + 滚动提示）
 *   之后 4 屏各占满一屏，切换完全交给浏览器原生滚动吸附（不做自定义滚轮）
 *   顶部有分节导航，右下角有 NN / 04 计数 —— 两者在标题屏隐藏
 * 内容来自 src/content/pages/about.md（改内容不用碰这个文件）。
 */
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Background from "../components/effects/Background.astro";
import { externalAttrs } from "../lib/url";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("缺少 src/content/pages/about.md —— 关于页的内容源。");
}

const data = about.data;

const sections = [
  { id: "profile", index: "01", label: "PROFILE", name: "简介" },
  { id: "experience", index: "02", label: "EXPERIENCE", name: "经历" },
  { id: "stack", index: "03", label: "STACK", name: "技能" },
  { id: "contact", index: "04", label: "CONTACT", name: "联系" },
];
---

<BaseLayout title={data.title} description={data.summary}>
  <!-- 整页背景：双摆（常亮，铺满视口） -->
  <Background
    scene="pendulum"
    description="背景：实时双摆混沌模拟（末端轨迹），纯装饰元素。"
  />

  <!-- 分节导航：吸在顶栏下方；标题屏隐藏 -->
  <nav
    id="about-nav"
    class="sticky top-14 z-40 border-b border-line-0 bg-bg-0 transition-opacity duration-[var(--dur-base)]"
    aria-label="关于页分节"
  >
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-7 gap-y-2 px-6 py-3">
      {sections.map((section) => (
        <a
          href={`#${section.id}`}
          class="about-nav-link flex items-center gap-2 font-mono text-micro tracking-[0.1em] text-fg-3 uppercase no-underline transition-colors duration-[var(--dur-base)] hover:text-fg-0"
          data-section={section.id}
        >
          <span
            class="block h-px w-2 bg-current transition-[width] duration-[var(--dur-base)]"
            aria-hidden="true"
          />
          {section.index} {section.name}
        </a>
      ))}
    </div>
  </nav>

  <!-- 右下角计数：标题屏隐藏 -->
  <p
    id="about-count"
    class="fixed right-6 bottom-6 z-40 font-mono text-micro tracking-[0.14em] text-fg-3 transition-opacity duration-[var(--dur-base)]"
    aria-hidden="true"
  >
    01 / 04
  </p>

  <!-- 第 1 屏：标题 -->
  <section id="about-top" class="asection">
    <Container width="layout">
      <p class="font-mono text-micro tracking-[0.2em] text-fg-3 uppercase">
        About · Profile
      </p>
      <h1
        data-title-split
        class="mt-5 text-[clamp(30px,3.6vw,50px)] leading-[1.16] font-semibold tracking-[-0.03em] text-fg-0"
      >
        {data.title}
      </h1>
      <p class="mt-8 max-w-[52ch] text-step-0 leading-[1.9] text-fg-2">{data.summary}</p>

      <div class="mt-16 flex items-center gap-3" aria-hidden="true">
        <span class="block h-10 w-px bg-line-1"></span>
        <span class="font-mono text-micro tracking-[0.2em] text-fg-3 uppercase">
          Scroll
        </span>
      </div>
    </Container>
  </section>

  <!-- 01 简介 -->
  <section id="profile" class="asection">
    <Container width="layout">
      <p class="font-mono text-micro tracking-[0.16em] text-fg-3 uppercase">01 / Profile</p>
      <h2 class="mt-5 text-step-3 font-semibold tracking-[-0.02em] text-fg-0">简介</h2>

      <div class="mt-10 max-w-[62ch] space-y-5">
        {data.intro.map((paragraph) => (
          <p class="text-step-0 leading-[2] text-fg-1">{paragraph}</p>
        ))}
      </div>
    </Container>
  </section>

  <!-- 02 经历 -->
  <section id="experience" class="asection">
    <Container width="layout">
      <p class="font-mono text-micro tracking-[0.16em] text-fg-3 uppercase">
        02 / Experience
      </p>
      <h2 class="mt-5 text-step-3 font-semibold tracking-[-0.02em] text-fg-0">经历</h2>

      <ul class="mt-10 max-w-[62ch] list-none p-0">
        {data.experience.map((item, index) => (
          <li
            class:list={[
              "flex flex-col gap-2 py-4 sm:flex-row sm:gap-8",
              index > 0 && "border-t border-line-0",
            ]}
          >
            <span class="w-[10ch] shrink-0 font-mono text-micro tracking-[0.1em] text-fg-3 tabular-nums">
              {item.year}
            </span>
            <span class="text-step-0 leading-[1.9] text-fg-1">{item.text}</span>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- 03 技能 -->
  <section id="stack" class="asection">
    <Container width="layout">
      <p class="font-mono text-micro tracking-[0.16em] text-fg-3 uppercase">03 / Stack</p>
      <h2 class="mt-5 text-step-3 font-semibold tracking-[-0.02em] text-fg-0">技能</h2>

      <dl class="mt-10 grid max-w-[62ch] gap-8 sm:grid-cols-2">
        {data.skills.map((group) => (
          <div>
            <dt class="font-mono text-micro tracking-[0.12em] text-fg-3 uppercase">
              {group.group}
            </dt>
            <dd class="mt-4 m-0 flex flex-wrap gap-x-5 gap-y-2">
              {group.items.map((item) => (
                <span class="font-mono text-[12.5px] tracking-[0.06em] text-fg-1">
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  <!-- 04 联系 -->
  <section id="contact" class="asection">
    <Container width="layout">
      <p class="font-mono text-micro tracking-[0.16em] text-fg-3 uppercase">04 / Contact</p>
      <h2 class="mt-5 text-step-3 font-semibold tracking-[-0.02em] text-fg-0">联系</h2>

      <ul class="mt-10 max-w-[62ch] list-none p-0">
        {data.contacts.map((contact, index) => (
          <li
            class:list={[
              "flex flex-col gap-2 py-4 sm:flex-row sm:gap-8",
              index > 0 && "border-t border-line-0",
            ]}
          >
            <span class="w-[10ch] shrink-0 font-mono text-micro tracking-[0.1em] text-fg-3 uppercase">
              {contact.label}
            </span>
            {contact.url ? (
              <a
                href={contact.url}
                class="text-step-0 text-fg-1 no-underline transition-colors duration-[var(--dur-base)] hover:text-fg-0"
                {...externalAttrs(contact.url)}
              >
                {contact.value}
              </a>
            ) : (
              <span class="text-step-0 text-fg-1">{contact.value}</span>
            )}
          </li>
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>

<style is:global>
  /* 原生滚动吸附：整页一次一屏（§4.5.4 v2） */
  html.is-about {
    scroll-snap-type: y mandatory;
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-about {
      scroll-snap-type: none;
    }
  }

  .asection {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    /*
     * 文字落位：屏幕自上而下约 1/4 处，下方留白给背景动效（不是几何正中 ——
     * 顶上有吸顶栏与分节导航，居中看起来会明显偏低）。
     * 分节对齐到视口顶部时，区块顶部本来就在 scroll-margin-top 的位置（6.5rem），
     * 所以这里要把它减掉，才是"文字真正落在 1/4 处"。
     */
    padding-block: max(var(--space-6), calc(25dvh - 6.5rem)) var(--space-12);
    /* 吸顶顶栏 + 分节导航会盖住内容，用 scroll-margin 补偿 */
    scroll-margin-top: 6.5rem;
    scroll-snap-align: start;
  }

  .about-nav-link[aria-current="true"] {
    color: var(--color-fg-0);
  }

  .about-nav-link[aria-current="true"] span {
    width: 14px;
  }
</style>
