---
/**
 * 全文搜索页（Pagefind）。
 *
 * Pagefind 在 `pnpm build` 之后由 postbuild 步骤扫描 dist/ 生成索引，
 * 索引是纯静态文件，没有任何第三方请求；这里只在用户开始输入时才动态加载它。
 * 本地 `pnpm dev` 环境没有索引，会给出明确提示而不是静默失败。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import { SITE } from "../config/site";
---

<BaseLayout title="搜索" description={`在 ${SITE.name} 全站搜索文章与项目。`}>
  <Container width="layout" class="py-16">
    <p class="font-mono text-micro tracking-[0.16em] text-fg-3 uppercase">
      Full-text Search
    </p>
    <h1 class="mt-4 text-step-3 font-semibold tracking-[-0.02em] text-fg-0">搜索</h1>

    {SITE.features.search ? (
      <>
        <input
          id="search-input"
          class="search-input mt-10 max-w-[520px]"
          type="search"
          placeholder="输入关键词…"
          aria-label="全站搜索"
          autocomplete="off"
        />

        <div
          id="search-results"
          class="mt-10 flex max-w-[720px] flex-col"
          aria-live="polite"
        />

        <!-- 面向访客的提示：只说"怎么用"，不出现任何本机命令或构建细节 -->
        <p
          id="search-message"
          class="mt-6 max-w-[60ch] font-mono text-micro leading-[1.9] text-fg-3"
        >
          输入关键词，即可搜索全站的文章与项目。
        </p>
      </>
    ) : (
      <p class="mt-10 font-mono text-micro text-fg-3">
        搜索当前处于关闭状态（src/config/site.ts 的 features.search）。
      </p>
    )}
  </Container>
</BaseLayout>

<!--
  注意：这里必须用 is:inline（原样输出，不经过打包器）。
  原因：Astro 会把体积小的脚本内联进 HTML，而 Vite 处理过的动态 import 会引用
  一个只在独立脚本文件里存在的辅助变量（__VITE_PRELOAD__），内联后就变成
  ReferenceError。Pagefind 的模块只能在运行时从 /pagefind/ 动态加载，
  所以这条路必须走原生 import。
-->
