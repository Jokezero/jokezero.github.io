---
/**
 * 页脚：社交链接 + 版权 + 构建戳。
 * 全部使用等宽微标签，与顶栏同一套语言；不引入卡片、不做底色填充。
 *
 * 这里**不放导航**：顶栏已经承担了信息架构，页脚再放一份就是重复的导览条。
 * 页脚只留三类信息：版权、顶栏没有的入口（全文搜索）、元信息（GitHub / 构建戳）。
 */
import { SITE } from "../../config/site";
import { externalAttrs } from "../../lib/url";
import { SITE_VERSION } from "../../lib/version";

const year = new Date().getFullYear();

// 版本号：v<年>.<月>.<当月功能更新次数>.<当月修复与维护次数>，由 git 历史自动算出
const versionHint = "版本号：年.月.当月功能更新次数.当月修复与维护次数";

// 过滤掉没有填写的链接（例如邮箱暂时为空）。
const socials = SITE.social.filter((item) => item.href);
const utilityLinks = SITE.footerLinks;
---

<footer class="relative z-[2] mt-24 border-t border-line-0">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-4 px-6 py-8 md:flex-row md:items-center md:justify-between">
    <p class="font-mono text-micro tracking-[0.12em] text-fg-3 uppercase">
      © {year} {SITE.name} · Built with Astro
    </p>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 md:gap-x-6">
      {utilityLinks.map((item) => (
        <a
          href={item.href}
          class="tap font-mono text-micro tracking-[0.12em] text-fg-3 uppercase no-underline transition-colors duration-[var(--dur-base)] hover:text-fg-1"
          {...externalAttrs(item.href)}
        >
          {item.label}
        </a>
      ))}
      {socials.map((item) => (
        <a
          href={item.href}
          class="tap font-mono text-micro tracking-[0.12em] text-fg-3 uppercase no-underline transition-colors duration-[var(--dur-base)] hover:text-fg-1"
          {...externalAttrs(item.href)}
        >
          {item.label}
        </a>
      ))}
      <!-- 版本号：与站内链接同列（右下角），与重构前的排布一致 -->
      <span
        class="font-mono text-micro tracking-[0.12em] text-fg-3 uppercase"
        title={versionHint}
      >
        {SITE_VERSION.label}
      </span>
    </div>
  </div>
</footer>
