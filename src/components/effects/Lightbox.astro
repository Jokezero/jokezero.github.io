---
/**
 * 全屏图片灯箱（docs/07-layout-post-project.md §"灯箱（已确认使用）"）。
 *
 * 规则：不引第三方库；只处理带 data-lightbox 容器里的图片；
 * 支持左右方向键切换、Esc 关闭、焦点回到原图、关闭时不动滚动位置。
 * 页面没有图片时脚本直接返回，零开销。
 */
---

<dialog id="lightbox" class="lightbox" aria-label="图片查看">
  <div class="lightbox-stage">
    <img id="lightbox-image" alt="" />
  </div>

  <div class="lightbox-bar">
    <span
      id="lightbox-counter"
      class="font-mono text-micro text-fg-3"
      aria-live="polite"
    ></span>
    <span class="font-mono text-micro text-fg-3">← → 切换 · ESC 关闭</span>
  </div>

  <button
    id="lightbox-prev"
    type="button"
    class="lightbox-nav lightbox-prev"
    aria-label="上一张"
  >
    ←
  </button>
  <button
    id="lightbox-next"
    type="button"
    class="lightbox-nav lightbox-next"
    aria-label="下一张"
  >
    →
  </button>
</dialog>

<style is:global>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background-color: var(--color-bg-0);
    color: var(--color-fg-1);
  }

  .lightbox::backdrop {
    background-color: rgba(0, 0, 0, 0.92);
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    height: calc(100dvh - 64px);
    padding: 24px;
  }

  .lightbox-stage img {
    max-width: 100%;
    max-height: 100%;
    border: 1px solid var(--color-line-0);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 24px 20px;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    padding: 12px 16px;
    border: 0;
    background: none;
    color: var(--color-fg-2);
    font-family: var(--font-mono);
    font-size: 1rem;
    cursor: pointer;
    transition: color var(--dur-base) var(--ease-out);
  }

  .lightbox-nav:hover {
    color: var(--color-fg-0);
  }

  .lightbox-prev {
    left: 8px;
  }

  .lightbox-next {
    right: 8px;
  }

  /* 正文里的图片：包一层按钮，保留原排版（无边框、无内边距、块级） */
  .lightbox-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .lightbox-trigger img {
    display: block;
    width: 100%;
  }
</style>
