---
/**
 * 顶部 1px 阅读进度线（docs/01-design-spec.md §4.5.1 的 E10）。
 *
 * 原则：JS 只负责把一个 0→1 的数字写进 CSS 变量 --progress，
 * 真正的绘制交给 CSS（transform: scaleX），这样滚动时不会触发重排。
 * 只用在文章页与项目详情页。
 */
---

<div
  id="reading-progress"
  class="pointer-events-none fixed inset-x-0 top-0 z-60 h-px origin-left bg-line-2"
  style="transform: scaleX(var(--progress, 0));"
  aria-hidden="true"
>
</div>

<script>
  const bar = document.getElementById("reading-progress");

  if (bar) {
    let frame = 0;

    const update = () => {
      frame = 0;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      const progress =
        scrollable > 0 ? Math.min(1, Math.max(0, doc.scrollTop / scrollable)) : 0;
      bar.style.setProperty("--progress", String(progress));
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule, { passive: true });
    update();
  }
</script>
