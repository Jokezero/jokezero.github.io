---
/**
 * 文章列表：左侧索引栏（搜索 + 标签）+ 右侧无框竖直列表。
 *
 * 规范：docs/01-design-spec.md §4.5.2（版式）；
 *       docs/06-content-model.md §4（多选 OR + 命中数排序的语义）。
 *
 * 实现要点：列表和标签在**构建期**就渲染成真实 HTML（无 JS 也能读、也能被
 * Pagefind 索引），JS 只负责筛选、重排与空状态切换。
 */
interface PostItem {
  id: string;
  title: string;
  summary: string;
  pubDate: Date;
  tags: string[];
  href: string;
}

interface Props {
  items: PostItem[];
  /** 预选中的标签（来自 /tags/[tag] 这类入口） */
  initialTags?: string[];
}

const { items, initialTags = [] } = Astro.props;

// 标签栏由文章数据聚合而来（不做手写维护）。
const tags = [...new Set(items.flatMap((item) => item.tags))].sort((a, b) =>
  a.localeCompare(b, "zh-Hans-CN"),
);

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<div
  id="blog-index"
  class="grid gap-12 min-[900px]:grid-cols-[212px_1fr] min-[900px]:gap-[60px]"
  data-initial-tags={JSON.stringify(initialTags)}
>
  <!-- 索引栏：搜索 → 渐隐分隔线 → 标签（带命中数） -->
  <aside class="min-[900px]:sticky min-[900px]:top-24 min-[900px]:self-start">
    <input
      id="post-search"
      class="search-input"
      type="search"
      placeholder="搜索文章…"
      aria-label="按标题搜索文章"
      autocomplete="off"
    />

    <div class="divider-fade my-6"></div>

    <div
      id="tag-filter"
      class="flex flex-wrap gap-x-5 gap-y-3 min-[900px]:flex-col min-[900px]:gap-y-3"
      role="group"
      aria-label="按标签筛选（可多选）"
    >
      <button type="button" class="text-btn" data-tag="" aria-pressed="true">
        全部
      </button>
      {tags.map((tag) => (
        <button
          type="button"
          class="text-btn flex items-baseline gap-1.5"
          data-tag={tag}
          aria-pressed={initialTags.includes(tag) ? "true" : "false"}
        >
          {tag}
          <span class="text-[9.5px] text-fg-3" data-count>
            {items.filter((item) => item.tags.includes(tag)).length}
          </span>
        </button>
      ))}
    </div>
  </aside>

  <!-- 列表：每行 = 标题（可伸缩）→ 日期 → 标签；分隔线在行顶部、两头渐隐 -->
  <section>
    <ul id="post-list" class="m-0 list-none p-0">
      {items.map((item, index) => (
        <li
          class:list={["post-row", index === 0 && "is-first"]}
          data-title={item.title.toLowerCase()}
          data-tags={item.tags.join(",")}
          data-date={formatDate(item.pubDate)}
        >
          <a
            href={item.href}
            class="post-row-link flex flex-wrap items-baseline gap-x-6 gap-y-2 py-[19px] no-underline"
          >
            <span class="min-w-[16ch] flex-1 text-[15px] leading-[1.6] text-fg-2 transition-colors duration-[var(--dur-slow)] group-hover:text-fg-0 hover:text-fg-0">
              {item.title}
            </span>
            <time class="font-mono text-micro tracking-[0.1em] text-fg-3 tabular-nums">
              {formatDate(item.pubDate)}
            </time>
            <span class="font-mono text-micro tracking-[0.1em] text-fg-3">
              {item.tags.join(", ")}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <!-- 空状态（§4.5.2）：完全没有文章 vs 筛选后为空，文案不同 -->
    <p
      id="empty-posts"
      class="font-mono text-micro tracking-[0.1em] text-fg-3"
      hidden={items.length > 0}
    >
      暂无文章喵～正在努力学习
    </p>
    <p id="empty-match" class="font-mono text-micro tracking-[0.1em] text-fg-3" hidden>
      没有匹配的文章…
    </p>
  </section>
</div>

<style is:global>
  /* 重排时的轻量淡入；开启"减少动态效果"时由全局规则压成瞬时 */
  .post-row {
    opacity: 1;
  }

  .post-row.is-enter {
    animation: post-row-in var(--dur-base) var(--ease-out) both;
  }

  @keyframes post-row-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
