---
/**
 * 长文排版容器（Markdown / MDX 正文的默认样式）。
 *
 * 样式用 is:global 写在下面：因为我们包装的是插槽内容（渲染后的 HTML），
 * Astro 的组件作用域样式不会作用到子节点上。
 * 规范见 docs/07-layout-post-project.md（P2 会在此基础上细调）。
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["prose", className]}>
  <slot />
</div>

<style is:global>
  .prose {
    max-width: var(--measure);
    font-size: var(--text-step-0);
    line-height: 1.9;
    color: var(--color-fg-1);
  }

  .prose > * + * {
    margin-top: 1.15em;
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-fg-0);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .prose h2 {
    margin-top: 2.6em;
    font-size: var(--text-step-2);
  }

  .prose h3 {
    margin-top: 2em;
    font-size: var(--text-step-1);
  }

  .prose h4 {
    margin-top: 1.8em;
    font-size: var(--text-step-0);
  }

  .prose a {
    color: var(--color-fg-0);
    text-decoration: underline;
    text-decoration-color: var(--color-line-2);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .prose a:hover {
    text-decoration-color: var(--color-accent);
  }

  .prose strong {
    color: var(--color-fg-0);
    font-weight: 600;
  }

  .prose :not(pre) > code {
    padding: 0.12em 0.38em;
    border: 1px solid var(--color-line-0);
    border-radius: 3px;
    font-size: 0.88em;
    color: var(--color-fg-0);
  }

  .prose pre {
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-line-0);
    background-color: var(--color-bg-1);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .prose blockquote {
    padding-left: 1rem;
    border-left: 1px solid var(--color-line-2);
    color: var(--color-fg-2);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li + li {
    margin-top: 0.5em;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--color-line-0);
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-line-0);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
  }

  .prose th,
  .prose td {
    padding: 0.6em 0.8em;
    border-bottom: 1px solid var(--color-line-0);
    text-align: left;
  }

  .prose th {
    color: var(--color-fg-0);
    font-weight: 600;
  }
</style>
